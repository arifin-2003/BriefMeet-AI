# BriefMeet AI - Environment Configuration Template
# In Phase 1 (Frontend Only), these are not required as mock data is used.
# Copy this file to `.env.local` and fill in your own configuration locally.

# Tavily Search API (Used for web research & 30-day news aggregation)
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API (Used for briefing synthesis, entity extraction & question generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase client foundation (optional; the existing demo works without it)
# Use the project's frontend publishable key, never a secret or service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# App Mode
VITE_APP_ENV=development
